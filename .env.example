# 桌面 app 运行时环境变量(均可选,均有默认值)

# SQLite 数据库路径(默认 app data dir)
# SRE_GRAPH_DB_PATH=/tmp/sre-graph.sqlite

# WASM 模块根(默认 repo/modules)
# MODULES_ROOT=/abs/path/to/modules

# kubectl proxy API base(k8s connector 用;默认 http://127.0.0.1:8001)
# SRE_GRAPH_K8S_API_BASE=http://127.0.0.1:8001

# recovery handler 模式(mock 默认;real = 真改集群)
# SRE_GRAPH_HANDLER_MODE=mock

# 后台 sync 间隔秒(默认 30;0 = 禁用)
# SRE_GRAPH_SYNC_INTERVAL_SECS=30

# 报告邮件 SMTP(留空 = InMemory 回退,开箱即用)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
