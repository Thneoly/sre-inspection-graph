@pytest.fixture
def sample_path(sample_nodes, sample_edges):
    """构建一条完整的 Path: app → comp → deploy → pod → node"""
    apps = {n._id: n for n in sample_nodes}
    path_nodes = [
        apps["app:order"], apps["comp:order-api"], apps["deploy:order:order-api"],
        apps["pod:order:order-api-xxx"], apps["node:worker-01"],
    ]
    path_edges = sample_edges[:4]
    return MockNeo4jPath(path_nodes, path_edges)


@pytest.fixture
def mock_neo4j_run_query(sample_path):
    """创建一个预设的 run_query 替换函数"""
    def _runner(cypher: str, params: dict | None = None) -> list[dict]:
        if params and params.get("app_node_id") == "app:order":
            return [{"path": sample_path}]
        if params and params.get("node_id") == "node:worker-01":
            return [{"path": sample_path}]
        return [{"path": sample_path}]
    return _runner


@pytest.fixture
def client():
    """带 mock Neo4j 的 FastAPI TestClient（不依赖真实 Neo4j）"""
    with patch("app.routers.topology.run_query") as mock_topo, \
         patch("app.routers.access_link.run_query") as mock_link, \
         patch("app.routers.node_impact.run_query") as mock_impact, \
         patch("app.routers.config_impact.run_query") as mock_config, \
         patch("app.routers.image_risk.run_query") as mock_image, \
         patch("app.routers.alert_aggregation.run_query") as mock_alert, \
         patch("app.routers.health.check_connection") as mock_health:
        mock_health.return_value = True
        # Default — return empty to avoid errors
        for m in [mock_topo, mock_link, mock_impact, mock_config, mock_image, mock_alert]:
            m.return_value = []
        from app.main import app
        yield TestClient(app), {
            "topo": mock_topo, "link": mock_link, "impact": mock_impact,
            "config": mock_config, "image": mock_image, "alert": mock_alert,
        }
